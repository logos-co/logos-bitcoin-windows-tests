# The chain's settings, as chain.sh reads them: ports off the regtest defaults (drive.py's), P2P and
# Electrum on the LAN, RPC on loopback. HOST is this machine's LAN address; WHITELIST the LAN.
export CHAIN_DIR="${CHAIN_DIR:-$HOME/btc-win-chain}"
export RPC_PORT=28543 P2P_PORT=28544 FORK_RPC_PORT=28553 FORK_P2P_PORT=28554
export PEER_RPC_PORT=28563 PEER_P2P_PORT=28564 PRUNED_RPC_PORT=28573 PRUNED_P2P_PORT=28574
export ELECTRUM_PORTS=61701,61711
export LISTEN=0.0.0.0 HOST="${HOST:?HOST: the LAN address of this machine}"
# The /24 around HOST unless WHITELIST names another range.
export WHITELIST="${WHITELIST:-${HOST%.*}.0/24}"
